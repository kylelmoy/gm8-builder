<Project Sdk="Microsoft.NET.Sdk">

  <!-- A GML checker: the built-ins from Game Maker's fnames, the names from a
       split tree. Separate from the builder so a build needs none of it. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsAotCompatible>true</IsAotCompatible>
    <RootNamespace>Gm8Builder.Lint</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Gm8Builder\Gm8Builder.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Gm8Builder.Tests" />
  </ItemGroup>

</Project>
